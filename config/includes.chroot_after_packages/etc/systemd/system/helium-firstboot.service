[Unit]
Description=Helios first-boot setup (app sources and default apps)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/helium/firstboot.done
ConditionKernelCommandLine=!boot=live

[Service]
Type=oneshot
ExecStart=/usr/libexec/helium-firstboot
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
