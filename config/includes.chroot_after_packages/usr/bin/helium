#!/usr/bin/env python3
"""helium - the Helios package manager.

A friendly front-end for Flatpak. Apps come from the Helios repo first,
then Flathub, so you can install by short name: `helium install firefox`.
"""
import argparse
import base64
import configparser
import os
import shutil
import subprocess
import sys

VERSION = "0.1.0"
CONF = os.environ.get("HELIUM_CONF", "/etc/helium/helium.conf")
_cache = {}


def die(msg, code=1):
    print(f"helium: {msg}", file=sys.stderr)
    sys.exit(code)


def need(tool):
    if not shutil.which(tool):
        die(f"'{tool}' is not installed (try: sudo apt install {tool})")


def run(cmd, capture=False):
    return subprocess.run(cmd, text=True, capture_output=capture)


def must(cmd):
    if run(cmd).returncode != 0:
        die(f"command failed: {' '.join(cmd)}")


def load_conf():
    cp = configparser.ConfigParser()
    cp.read_dict({"helium": {"remotes": "helium, flathub", "scope": "system"}})
    cp.read(CONF)
    sec = cp["helium"]
    remotes = [r.strip() for r in sec["remotes"].split(",") if r.strip()]
    scope = sec["scope"].strip()
    if scope not in ("system", "user"):
        die(f"invalid scope '{scope}' in {CONF} (use system or user)")
    return remotes, scope


def configured_remotes(scope):
    r = run(["flatpak", "remotes", f"--{scope}", "--columns=name"], capture=True)
    return [l.strip() for l in r.stdout.splitlines() if l.strip()] if r.returncode == 0 else []


def remote_apps(remote, scope):
    key = (remote, scope)
    if key in _cache:
        return _cache[key]
    r = run(["flatpak", "remote-ls", f"--{scope}", "--app",
             "--columns=application,name", remote], capture=True)
    apps = []
    if r.returncode == 0:
        for line in r.stdout.splitlines():
            parts = line.split("\t")
            if parts[0].strip():
                apps.append((parts[0].strip(), parts[1].strip() if len(parts) > 1 else ""))
    else:
        print(f"helium: warning: remote '{remote}' could not be read", file=sys.stderr)
    _cache[key] = apps
    return apps


def installed_apps(scope):
    r = run(["flatpak", "list", f"--{scope}", "--app",
             "--columns=application,name,origin"], capture=True)
    out = []
    if r.returncode == 0:
        for line in r.stdout.splitlines():
            p = line.split("\t") + ["", ""]
            if p[0].strip():
                out.append((p[0].strip(), p[1].strip(), p[2].strip()))
    return out


def is_app_id(q):
    return q.count(".") >= 2 and " " not in q


def matches(q, app_id, name):
    ql = q.lower()
    if is_app_id(q):
        return app_id.lower() == ql
    return ql in app_id.lower() or ql in name.lower()


def choose(cands, query):
    """cands: list of (id, name, source). Returns one candidate or None."""
    ql = query.lower()
    exact = [c for c in cands
             if c[0].lower() == ql or c[1].lower() == ql or c[0].lower().rsplit(".", 1)[-1] == ql]
    pool, seen, uniq = (exact or cands), set(), []
    for c in pool:
        if c[0] not in seen:
            seen.add(c[0])
            uniq.append(c)
    if not uniq:
        return None
    if len(uniq) == 1:
        return uniq[0]
    print(f"'{query}' matches several apps:")
    for i, c in enumerate(uniq, 1):
        print(f"  {i}) {c[0]}  ({c[1]})  [{c[2]}]")
    if not sys.stdin.isatty():
        die("be more specific, or use the full app ID")
    try:
        n = int(input("Choose a number (0 to cancel): "))
    except (ValueError, EOFError):
        die("cancelled")
    if n < 1 or n > len(uniq):
        die("cancelled")
    return uniq[n - 1]


def remote_candidates(query, remotes, scope):
    have = configured_remotes(scope)
    out = []
    for remote in remotes:
        if remote not in have:
            continue
        for app_id, name in remote_apps(remote, scope):
            if matches(query, app_id, name):
                out.append((app_id, name, remote))
    return out


def cmd_install(a, remotes, scope):
    need("flatpak")
    failed = 0
    for q in a.apps:
        c = choose(remote_candidates(q, remotes, scope), q)
        if not c:
            print(f"helium: no app found for '{q}'", file=sys.stderr)
            failed += 1
            continue
        cmd = ["flatpak", "install", f"--{scope}"] + (["-y"] if a.yes else []) + [c[2], c[0]]
        print(f"==> installing {c[1] or c[0]} ({c[0]}) from {c[2]}")
        if run(cmd).returncode != 0:
            failed += 1
    return 1 if failed else 0


def cmd_remove(a, remotes, scope):
    need("flatpak")
    inst = installed_apps(scope)
    failed = 0
    for q in a.apps:
        cands = [(i, n, o) for i, n, o in inst if matches(q, i, n)]
        c = choose(cands, q)
        if not c:
            print(f"helium: '{q}' is not installed", file=sys.stderr)
            failed += 1
            continue
        cmd = ["flatpak", "uninstall", f"--{scope}"] + (["-y"] if a.yes else []) \
            + (["--delete-data"] if a.purge else []) + [c[0]]
        print(f"==> removing {c[1] or c[0]} ({c[0]})")
        if run(cmd).returncode != 0:
            failed += 1
    return 1 if failed else 0


def cmd_search(a, remotes, scope):
    need("flatpak")
    have = configured_remotes(scope)
    inst = {i for i, _, _ in installed_apps(scope)}
    q = a.query or ""
    rows, seen = [], set()
    for remote in remotes:
        if remote not in have:
            continue
        for app_id, name in remote_apps(remote, scope):
            if (not q or q.lower() in app_id.lower() or q.lower() in name.lower()) and app_id not in seen:
                seen.add(app_id)
                rows.append((app_id, name, remote))
    if not rows:
        print("no results")
        return 1
    print(f"  {'APP ID':46}{'NAME':28}SOURCE")
    for app_id, name, remote in sorted(rows, key=lambda r: r[1].lower()):
        print(f"{'*' if app_id in inst else ' '} {app_id:46.45}{name:28.27}{remote}")
    print("\n* = installed")
    return 0


def cmd_list(a, remotes, scope):
    need("flatpak")
    return run(["flatpak", "list", f"--{scope}", "--app",
                "--columns=application,name,version,origin"]).returncode


def cmd_update(a, remotes, scope):
    need("flatpak")
    cmd = ["flatpak", "update", f"--{scope}"] + (["-y"] if a.yes else [])
    return run(cmd).returncode


def cmd_clean(a, remotes, scope):
    need("flatpak")
    return run(["flatpak", "uninstall", f"--{scope}", "--unused"] + (["-y"] if a.yes else [])).returncode


def cmd_info(a, remotes, scope):
    need("flatpak")
    inst = [(i, n, o) for i, n, o in installed_apps(scope) if matches(a.app, i, n)]
    c = choose(inst, a.app)
    if c:
        return run(["flatpak", "info", f"--{scope}", c[0]]).returncode
    c = choose(remote_candidates(a.app, remotes, scope), a.app)
    if not c:
        die(f"no app found for '{a.app}'")
    return run(["flatpak", "remote-info", f"--{scope}", c[2], c[0]]).returncode


def cmd_run(a, remotes, scope):
    need("flatpak")
    inst = [(i, n, o) for i, n, o in installed_apps(scope) if matches(a.app, i, n)]
    c = choose(inst, a.app)
    if not c:
        die(f"'{a.app}' is not installed")
    os.execvp("flatpak", ["flatpak", "run", c[0]] + a.args)


def cmd_remote(a, remotes, scope):
    need("flatpak")
    if a.action == "list":
        return run(["flatpak", "remotes", f"--{scope}"]).returncode
    if a.action == "add":
        if not (a.name and a.url):
            die("usage: helium remote add NAME URL-or-.flatpakrepo [--no-gpg-verify]")
        cmd = ["flatpak", "remote-add", "--if-not-exists", f"--{scope}"]
        if a.no_gpg_verify:
            cmd.append("--no-gpg-verify")
        return run(cmd + [a.name, a.url]).returncode
    if a.action == "remove":
        if not a.name:
            die("usage: helium remote remove NAME")
        return run(["flatpak", "remote-delete", f"--{scope}", a.name]).returncode


def cmd_repo(a, remotes, scope):
    """Maintainer tools: build the OSTree repo that hosts your Helios apps."""
    repo = os.path.join(a.dir, "repo")
    if a.action == "init":
        need("ostree")
        os.makedirs(a.dir, exist_ok=True)
        must(["ostree", "init", "--mode=archive-z2", f"--repo={repo}"])
        print(f"initialised {repo}")
    elif a.action == "add":
        need("flatpak")
        if not a.files:
            die("usage: helium repo add DIR app.flatpak [more.flatpak ...]")
        for f in a.files:
            must(["flatpak", "build-import-bundle", repo, f])
    elif a.action == "update":
        need("flatpak")
        cmd = ["flatpak", "build-update-repo", "--generate-static-deltas", "--prune"]
        if a.gpg_sign:
            cmd.append(f"--gpg-sign={a.gpg_sign}")
        must(cmd + [repo])
        print(f"repo updated. Upload the whole '{repo}' folder to your web host.")
    elif a.action == "repofile":
        if not a.url:
            die("usage: helium repo repofile DIR --url https://host/path/repo [--gpg-key pub.gpg]")
        lines = ["[Flatpak Repo]", f"Title={a.title}", f"Url={a.url}",
                 "Comment=Apps for Helios OS"]
        if a.gpg_key:
            with open(a.gpg_key, "rb") as fh:
                lines.append("GPGKey=" + base64.b64encode(fh.read()).decode())
        out = os.path.join(a.dir, "helium.flatpakrepo")
        os.makedirs(a.dir, exist_ok=True)
        with open(out, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        print(f"wrote {out}")
    return 0


def cmd_doctor(a, remotes, scope):
    print(f"helium {VERSION}   config: {CONF}   scope: {scope}")
    if not shutil.which("flatpak"):
        print("[!!] flatpak is not installed")
        return 1
    print("[ok] flatpak found")
    have = configured_remotes(scope)
    for r in remotes:
        print(f"[{'ok' if r in have else '--'}] remote '{r}' {'configured' if r in have else 'not configured'}")
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="helium", description="The Helios package manager (Flatpak front-end).")
    p.add_argument("--version", action="version", version=f"helium {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="command")

    def add(name, fn, help_, aliases=()):
        sp = sub.add_parser(name, help=help_, aliases=list(aliases))
        sp.set_defaults(fn=fn)
        return sp

    sp = add("install", cmd_install, "install apps by name or app ID", ["add"])
    sp.add_argument("apps", nargs="+"); sp.add_argument("-y", "--yes", action="store_true")
    sp = add("remove", cmd_remove, "remove apps", ["uninstall", "rm"])
    sp.add_argument("apps", nargs="+"); sp.add_argument("-y", "--yes", action="store_true")
    sp.add_argument("--purge", action="store_true", help="also delete app data")
    sp = add("search", cmd_search, "search Helios and Flathub")
    sp.add_argument("query", nargs="?")
    add("list", cmd_list, "list installed apps")
    sp = add("update", cmd_update, "update all apps", ["upgrade"])
    sp.add_argument("-y", "--yes", action="store_true")
    sp = add("clean", cmd_clean, "remove unused runtimes", ["autoremove"])
    sp.add_argument("-y", "--yes", action="store_true")
    sp = add("info", cmd_info, "show app details"); sp.add_argument("app")
    sp = add("run", cmd_run, "run an installed app")
    sp.add_argument("app"); sp.add_argument("args", nargs=argparse.REMAINDER)
    sp = add("remote", cmd_remote, "manage app sources")
    sp.add_argument("action", choices=["list", "add", "remove"])
    sp.add_argument("name", nargs="?"); sp.add_argument("url", nargs="?")
    sp.add_argument("--no-gpg-verify", action="store_true")
    sp = add("repo", cmd_repo, "maintainer tools to host your own Helios app repo")
    sp.add_argument("action", choices=["init", "add", "update", "repofile"])
    sp.add_argument("dir"); sp.add_argument("files", nargs="*")
    sp.add_argument("--gpg-sign"); sp.add_argument("--url"); sp.add_argument("--gpg-key")
    sp.add_argument("--title", default="Helios Apps")
    add("doctor", cmd_doctor, "check the helium setup")
    return p


def main():
    p = build_parser()
    a = p.parse_args()
    if not getattr(a, "fn", None):
        p.print_help()
        return 0
    remotes, scope = load_conf()
    return a.fn(a, remotes, scope) or 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
